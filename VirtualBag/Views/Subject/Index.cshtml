@{
}
@model List<BLL.DTOs.SubjectDTO>

@{
    ViewData["Title"] = "Index";
}

<h1>Subject List</h1>

@if (TempData["Msg"] != null)
{
    <p class="text-success">
        @TempData["Msg"]
    </p>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Subject </a>
</p>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Subject Id</th>
            <th>Subject Name</th>
            <th>Class Id</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.SubjectId</td>
                    <td>@item.SubjectName</td>
                    <td>@item.ClassId</td>

                    <td>
                        <a asp-action="Update"asp-route-id="@item.SubjectId"class="btn btn-warning">Edit</a>

                        <a asp-action="Delete"asp-route-id="@item.SubjectId"class="btn btn-danger">Delete </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">No Subject Found </td>
            </tr>
        }

    </tbody>

</table>