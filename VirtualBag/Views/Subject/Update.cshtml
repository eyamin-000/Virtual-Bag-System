@{
}
@model BLL.DTOs.SubjectDTO

@{
    ViewData["Title"] = "Update";
}

<h1>Update Subject</h1>

<form method="post">

    <input asp-for="SubjectId" hidden />

    <div class="form-group">
        <label>Subject Name</label>
        <input asp-for="SubjectName" class="form-control" />
        <span asp-validation-for="SubjectName" class="text-danger"></span>
    </div>

    <div class="form-group mt-2">
        <label>Class</label>

        <select asp-for="ClassId" class="form-control">

            @foreach (var c in ViewBag.Classes)
            {
                <option value="@c.ClassId">
                    @c.ClassName
                </option>
            }

        </select>

        <span asp-validation-for="ClassId" class="text-danger"></span>
    </div>

    <div><input asp-for="CreatedAt" hidden /></div>

    <div class="mt-3">
        <input type="submit" value="Update" class="btn btn-success" />
    </div>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}