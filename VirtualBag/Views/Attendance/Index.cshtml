@{
}
@model List<BLL.DTOs.AttendanceDTO>

<h1>Attendance List</h1>

@if (TempData["Msg"] != null)
{
    <p class="text-success">
        @TempData["Msg"]
    </p>
}

<p>
    <a asp-action="Create" class="btn btn-primary"> Mark Attendance </a>
</p>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Attendance Id</th>
            <th>Session Id</th>
            <th>Student Id</th>
            <th>Status</th>
            <th>Remarks</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.AttendanceId</td>
                    <td>@item.SessionId</td>
                    <td>@item.StudentId</td>
                    <td>@item.Status</td>
                    <td>@item.Remarks</td>

                    <td>
                        <a asp-action="Update" asp-route-id="@item.AttendanceId" class="btn btn-warning"> Edit </a>

                        <a asp-action="Delete" asp-route-id="@item.AttendanceId" class="btn btn-danger"> Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6"class="text-center">No Attendance Found </td>
            </tr>
        }

    </tbody>

</table>