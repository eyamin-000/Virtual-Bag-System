@{
}
@model BLL.DTOs.AttendanceDTO

<h1>Update Attendance</h1>

<form method="post">

    <input asp-for="AttendanceId" hidden />

    <div class="form-group">
        <label>Attendance Session</label>

        <select asp-for="SessionId" class="form-control">

            @foreach (var s in ViewBag.Sessions)
            {
                <option value="@s.SessionId">
                    Session @s.SessionId
                </option>
            }

        </select>
    </div>

    <div class="form-group mt-2">
        <label>Student</label>

        <select asp-for="StudentId" class="form-control">

            @foreach (var s in ViewBag.Students)
            {
                <option value="@s.UserId">
                    @s.FullName
                </option>
            }

        </select>
    </div>

    <div class="form-group mt-2">
        <label>Status</label>

        <select asp-for="Status" class="form-control">
            <option value="Present">Present</option>
            <option value="Absent">Absent</option>
        </select>
    </div>

    <div class="form-group mt-2">
        <label>Remarks</label>
        <textarea asp-for="Remarks" class="form-control">
        </textarea>
        </div>

        <div class="mt-3">
            <input type="submit" value="Update" class="btn btn-success" />
        </div>

    </form>