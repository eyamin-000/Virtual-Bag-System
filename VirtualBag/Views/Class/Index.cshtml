@model List<BLL.DTOs.ClassDTO>

@{
    ViewData["Title"] = "Index";
}

<h1>Class List</h1>

@if (TempData["Msg"] != null)
{
    <p class="text-success">@TempData["Msg"]</p>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Class</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Class Id</th>
            <th>Class Name</th>
            <th>Section</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.ClassId</td>
                    <td>@item.ClassName</td>
                    <td>@item.Section</td>
                    <td>
                        <a asp-action="Update" asp-route-id="@item.ClassId" class="btn btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.ClassId" class="btn btn-danger">Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">No class found</td>
            </tr>
        }
    </tbody>
</table>