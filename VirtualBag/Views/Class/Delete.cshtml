@{
}
@model BLL.DTOs.ClassDTO

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete Class</h1>

<h4>Are you sure?</h4>

<form method="post">

    <input asp-for="ClassId" hidden />

    <table class="table table-bordered">
        <tr>
            <th>Class Name</th>
            <td>@Model.ClassName</td>
        </tr>

        <tr>
            <th>Section</th>
            <td>@Model.Section</td>
        </tr>
    </table>

    <button name="Decison" value="Yes" class="btn btn-danger"> Yes </button>

    <button name="Decison" value="No" class="btn btn-secondary"> No
    </button>

</form>