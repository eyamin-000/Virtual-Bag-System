@{
}
@model BLL.DTOs.HomeworkSubmissionDTO

<h1>Update Submission</h1>

<form method="post">

    <input asp-for="SubmissionId" hidden />
    <input asp-for="SubmittedAt" hidden />

    <div class="form-group">
        <label>Homework</label>

        <select asp-for="HomeworkId" class="form-control">

            @foreach (var h in ViewBag.Homeworks)
            {
                <option value="@h.HomeworkId">
                    @h.Title
                </option>
            }

        </select>
    </div>

    <div class="form-group mt-2">
        <label>Student</label>

        <select asp-for="StudentId" class="form-control">

            @foreach (var s in ViewBag.Students)
            {
                <option value="@s.UserId">
                    @s.FullName
                </option>
            }

        </select>
    </div>

    <div class="form-group mt-2">
        <label>Submission Text</label>
        <textarea asp-for="SubmissionText" class="form-control"> </textarea>
        </div>

        <div class="form-group mt-2">
            <label>File Path</label>
            <input asp-for="FilePath" class="form-control" />
        </div>

        <div class="form-group mt-2">
            <label>Status</label>

            <select asp-for="Status" class="form-control">
                <option value="Submitted">Submitted</option>
                <option value="Reviewed">Reviewed</option>
            </select>
        </div>

        <div class="form-group mt-2">
            <label>Marks</label>
            <input asp-for="Marks" class="form-control" />
        </div>

        <div class="form-group mt-2">
            <label>Feedback</label>
            <textarea asp-for="Feedback" class="form-control">
        </textarea>
            </div>

            <div class="mt-3">
                <input type="submit" value="Update" class="btn btn-success" />
            </div>

        </form>