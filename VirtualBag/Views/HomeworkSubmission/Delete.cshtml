@{
}
@model BLL.DTOs.HomeworkSubmissionDTO

<h1>Delete Submission</h1>

<h4>Are you sure?</h4>

<form method="post">

    <input asp-for="SubmissionId" hidden />

    <table class="table table-bordered">

        <tr>
            <th>Submission Text</th>
            <td>@Model.SubmissionText</td>
        </tr>

        <tr>
            <th>Status</th>
            <td>@Model.Status</td>
        </tr>

        <tr>
            <th>Marks</th>
            <td>@Model.Marks</td>
        </tr>

    </table>

    <button name="Decison" value="Yes" class="btn btn-danger"> Yes </button>

    <button name="Decison"value="No" class="btn btn-secondary">No</button>

</form>