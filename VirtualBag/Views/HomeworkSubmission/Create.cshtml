@{
}
@model BLL.DTOs.HomeworkSubmissionDTO

<h1>Submit Homework</h1>

<form method="post">

    <input asp-for="StudentId" hidden />

    <div class="form-group">
        <label>Homework</label>

        <select asp-for="HomeworkId" class="form-control">
            <option value="">Select Homework</option>

            @foreach (var h in ViewBag.Homeworks)
            {
                <option value="@h.HomeworkId"> @h.Title </option>
            }
        </select>
    </div>

    <div class="form-group mt-2">
        <label>Submission Text</label>

        <textarea asp-for="SubmissionText" class="form-control" rows="6"></textarea>
    </div>

    <div class="form-group mt-2">
        <label>File Path</label>

        <input asp-for="FilePath" class="form-control" />
    </div>

    <div class="mt-3">
        <input type="submit" value="Submit Homework" class="btn btn-primary" />
    </div>

</form>