@{
}
@model BLL.DTOs.AttendanceSessionDTO

<h1>Create Attendance Session</h1>

<form method="post">

    <div asp-validation-summary="All"
         class="text-danger">
    </div>

    <input asp-for="TeacherId" hidden />

    <div class="form-group mt-2">
        <label>Class</label>

        <select asp-for="ClassId"
                class="form-control">

            <option value="">
                Select Class
            </option>

            @foreach (var c in ViewBag.Classes)
            {
                <option value="@c.ClassId">
                    @c.ClassName
                </option>
            }

        </select>

        <span asp-validation-for="ClassId"
              class="text-danger">
        </span>
    </div>

    <div class="form-group mt-2">
        <label>Subject</label>

        <select asp-for="SubjectId"
                class="form-control">

            <option value="">
                Select Subject
            </option>

            @foreach (var s in ViewBag.Subjects)
            {
                <option value="@s.SubjectId">
                    @s.SubjectName
                </option>
            }

        </select>

        <span asp-validation-for="SubjectId" class="text-danger">
        </span>
    </div>

    <div class="form-group mt-2">
        <label>Attendance Date</label>

        <input asp-for="AttendanceDate" type="date" class="form-control" />

        <span asp-validation-for="AttendanceDate" class="text-danger">
        </span>
    </div>

    <div class="mt-3">
        <input type="submit" value="Create"class="btn btn-primary" />
    </div>

</form>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}