@{
}
@model BLL.DTOs.AttendanceSessionDTO

<h1>Update Attendance Session</h1>

<form method="post">

    <div asp-validation-summary="All" class="text-danger">
    </div>

    <input asp-for="SessionId" hidden />
    <input asp-for="TeacherId" hidden />
    <input asp-for="CreatedAt" hidden />

    <div class="form-group mt-2">
        <label>Class</label>

        <select asp-for="ClassId" class="form-control">

            @foreach (var c in ViewBag.Classes)
            {
                <option value="@c.ClassId">
                    @c.ClassName
                </option>
            }

        </select>

        <span asp-validation-for="ClassId" class="text-danger">
        </span>
    </div>

    <div class="form-group mt-2">
        <label>Subject</label>

        <select asp-for="SubjectId" class="form-control">

            @foreach (var s in ViewBag.Subjects)
            {
                <option value="@s.SubjectId">
                    @s.SubjectName
                </option>
            }

        </select>

        <span asp-validation-for="SubjectId"  class="text-danger">
        </span>
    </div>

    <div class="form-group mt-2">
        <label>Attendance Date</label>

        <input asp-for="AttendanceDate" type="date" class="form-control" />

        <span asp-validation-for="AttendanceDate" class="text-danger"> </span>
    </div>

    <div class="mt-3">
        <input type="submit" value="Update" class="btn btn-success" />
    </div>

</form>