@{
}
@model BLL.DTOs.AttendanceSessionDTO

<h1>Delete Attendance Session</h1>

<h4>Are you sure?</h4>

<form method="post">

    <input asp-for="SessionId" hidden />

    <table class="table table-bordered">

        <tr>
            <th>Teacher Id</th>
            <td>@Model.TeacherId</td>
        </tr>

        <tr>
            <th>Class Id</th>
            <td>@Model.ClassId</td>
        </tr>

        <tr>
            <th>Attendance Date</th>
            <td>@Model.AttendanceDate</td>
        </tr>

    </table>

    <button name="Decison" value="Yes" class="btn btn-danger">Yes</button>

    <button name="Decison" value="No" class="btn btn-secondary">No
</button>

</form>