@{
}
@model BLL.DTOs.NoteDTO

<h1>Delete Note</h1>

<h4>Are you sure?</h4>

<form method="post">

    <input asp-for="NoteId" hidden />

    <table class="table table-bordered">

        <tr>
            <th>Title</th>
            <td>@Model.Title</td>
        </tr>

        <tr>
            <th>Content</th>
            <td>@Model.NoteContent</td>
        </tr>

        <tr>
            <th>Color</th>
            <td>@Model.NoteColor</td>
        </tr>

    </table>

    <button name="Decison"value="Yes" class="btn btn-danger">Yes</button>

    <button name="Decison"value="No" class="btn btn-secondary"> No </button>

</form>