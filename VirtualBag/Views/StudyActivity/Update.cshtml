@{
}
@model BLL.DTOs.StudyActivityDTO

<h1>Update Study Activity</h1>

<form method="post">

    <input asp-for="ActivityId" hidden />
    <input asp-for="ActivityDate" hidden />

    <div class="form-group">
        <label>Student</label>

        <select asp-for="StudentId" class="form-control">

            @foreach (var s in ViewBag.Students)
            {
                <option value="@s.UserId">
                    @s.FullName
                </option>
            }

        </select>
    </div>

    <div class="form-group mt-2">
        <label>Activity Type</label>

        <select asp-for="ActivityType" class="form-control">
            <option value="Book Opened">Book Opened</option>
            <option value="Note Created">Note Created</option>
            <option value="Homework Submitted">Homework Submitted</option>
            <option value="Attendance Marked">Attendance Marked</option>
        </select>
    </div>

    <div class="form-group mt-2">
        <label>Description</label>

        <textarea asp-for="Description" rows="4" class="form-control">
        </textarea>
        </div>

        <div class="mt-3">
            <input type="submit" value="Update" class="btn btn-success" />
        </div>

    </form>