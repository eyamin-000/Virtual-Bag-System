@{
}
@model BLL.DTOs.StudyActivityDTO

<h1>Delete Study Activity</h1>

<h4>Are you sure?</h4>

<form method="post">

    <input asp-for="ActivityId" hidden />

    <table class="table table-bordered">

        <tr>
            <th>Activity Type</th>
            <td>@Model.ActivityType</td>
        </tr>

        <tr>
            <th>Description</th>
            <td>@Model.Description</td>
        </tr>

        <tr>
            <th>Activity Date</th>
            <td>@Model.ActivityDate</td>
        </tr>

    </table>

    <button name="Decison" value="Yes" class="btn btn-danger">Yes </button>

    <button name="Decison" value="No"class="btn btn-secondary"> No </button>

</form>