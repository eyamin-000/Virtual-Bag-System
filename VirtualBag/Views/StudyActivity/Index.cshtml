@{
}
@model List<BLL.DTOs.StudyActivityDTO>

<h1>Study Activity List</h1>

@if (TempData["Msg"] != null)
{
    <p class="text-success">
        @TempData["Msg"]
    </p>
}

<p>
    <a asp-action="Create" class="btn btn-primary"> Create Study Activity </a>
</p>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Activity Id</th>
            <th>Student Id</th>
            <th>Activity Type</th>
            <th>Description</th>
            <th>Activity Date</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.ActivityId</td>
                    <td>@item.StudentId</td>
                    <td>@item.ActivityType</td>
                    <td>@item.Description</td>
                    <td>@item.ActivityDate</td>

                    <td>
                        <a asp-action="Update" asp-route-id="@item.ActivityId" class="btn btn-warning">  Edit </a>

                        <a asp-action="Delete" asp-route-id="@item.ActivityId" class="btn btn-danger"> Delete </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center"> No Study Activity Found </td>
            </tr>
        }

    </tbody>

</table>