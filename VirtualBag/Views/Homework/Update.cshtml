@{
}
@model BLL.DTOs.HomeworkDTO

<h1>Update Homework</h1>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <input asp-for="HomeworkId" hidden />
    <input asp-for="TeacherId" hidden />

    <div class="form-group mt-2">
        <label>Class</label>

        <select asp-for="ClassId" class="form-control">

            @foreach (var c in ViewBag.Classes)
            {
                <option value="@c.ClassId"> @c.ClassName </option>
            }

        </select>
    </div>

    <div class="form-group mt-2">
        <label>Subject</label>

        <select asp-for="SubjectId" class="form-control">

            @foreach (var s in ViewBag.Subjects)
            {
                <option value="@s.SubjectId"> @s.SubjectName </option>
            }

        </select>
    </div>

    <div class="form-group mt-2">
        <label>Title</label>

        <input asp-for="Title"class="form-control" />
    </div>

    <div class="form-group mt-2">
        <label>Description</label>

        <textarea asp-for="Description" class="form-control" rows="5"></textarea>
    </div>

    <div class="form-group mt-2">
        <label>Deadline</label>

        <input asp-for="Deadline" type="datetime-local" class="form-control" />
    </div>

    <div class="mt-3">
        <input type="submit"value="Update"class="btn btn-success" />
    </div>

</form>