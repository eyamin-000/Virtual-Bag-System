@{
}
@model BLL.DTOs.BookDTO

@{
    ViewData["Title"] = "Update";
}

<h1>Update Book</h1>

<form method="post">

    <input asp-for="BookId" hidden />
    <input asp-for="UploadedAt" hidden />

    <div class="form-group">
        <label>Title</label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="form-group mt-2">
        <label>Author</label>
        <input asp-for="Author" class="form-control" />
    </div>

    <div class="form-group mt-2">
        <label>Class</label>

        <select asp-for="ClassId" class="form-control">

            @foreach (var c in ViewBag.Classes)
            {
                <option value="@c.ClassId">
                    @c.ClassName
                </option>
            }

        </select>
    </div>

    <div class="form-group mt-2">
        <label>Subject</label>

        <select asp-for="SubjectId" class="form-control">

            @foreach (var s in ViewBag.Subjects)
            {
                <option value="@s.SubjectId">
                    @s.SubjectName
                </option>
            }

        </select>
    </div>

    <div class="form-group mt-2">
        <label>File Path</label>
        <input asp-for="FilePath" class="form-control" />
    </div>

    <div class="mt-3">
        <input type="submit" value="Update" class="btn btn-success" />
    </div>

</form>