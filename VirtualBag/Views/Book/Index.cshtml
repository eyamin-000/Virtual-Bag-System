@{
}
@model List<BLL.DTOs.BookDTO>

@{
    ViewData["Title"] = "Index";
}

<h1>Book List</h1>

@if (TempData["Msg"] != null)
{
    <p class="text-success">
        @TempData["Msg"]
    </p>
}

<form method="get">

    <div class="row mb-3">

        <div class="col-md-4">
            <input type="text" name="search" class="form-control" placeholder="Search Book Title" />
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-success"> Search
            </button>
        </div>

    </div>

</form>

<p>
    <a asp-action="Create" class="btn btn-primary"> Create New Book </a>
</p>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Book Id</th>
            <th>Title</th>
            <th>Author</th>
            <th>Class Id</th>
            <th>Subject Id</th>
            <th>Book</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.BookId</td>
                    <td>@item.Title</td>
                    <td>@item.Author</td>
                    <td>@item.ClassId</td>
                    <td>@item.SubjectId</td>

                    <td>
                        <a href="@item.FilePath" target="_blank" class="btn btn-info"> Open </a>
                    </td>

                    <td>
                        <a asp-action="Update" asp-route-id="@item.BookId" class="btn btn-warning"> Edit</a>

                        <a asp-action="Delete" asp-route-id="@item.BookId" class="btn btn-danger"> Delete </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center">  No Book Found</td>
            </tr>
        }

    </tbody>

</table>