@{
}
@model BLL.DTOs.TeacherAssignmentDTO

<h1>Assign Teacher</h1>

<form method="post">

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label>Teacher</label>

        <select asp-for="TeacherId" class="form-control">
            <option value="">Select Teacher</option>

            @foreach (var t in ViewBag.Teachers)
            {
                <option value="@t.UserId">
                    @t.FullName
                </option>
            }
        </select>
    </div>

    <div class="form-group mt-2">
        <label>Class</label>

        <select asp-for="ClassId" class="form-control">
            <option value="">Select Class</option>

            @foreach (var c in ViewBag.Classes)
            {
                <option value="@c.ClassId">
                    @c.ClassName
                </option>
            }
        </select>
    </div>

    <div class="form-group mt-2">
        <label>Subject</label>

        <select asp-for="SubjectId" class="form-control">
            <option value="">Select Subject</option>

            @foreach (var s in ViewBag.Subjects)
            {
                <option value="@s.SubjectId">
                    @s.SubjectName
                </option>
            }
        </select>
    </div>

    <div class="mt-3">
        <input type="submit" value="Assign" class="btn btn-primary" />
    </div>

</form>