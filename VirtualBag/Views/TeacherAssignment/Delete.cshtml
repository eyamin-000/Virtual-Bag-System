@{
}
@model BLL.DTOs.TeacherAssignmentDTO

<h1>Delete Teacher Assignment</h1>

<h4>Are you sure?</h4>

<form method="post">

    <input asp-for="AssignmentId" hidden />

    <table class="table table-bordered">

        <tr>
            <th>Teacher Id</th>
            <td>@Model.TeacherId</td>
        </tr>

        <tr>
            <th>Class Id</th>
            <td>@Model.ClassId</td>
        </tr>

        <tr>
            <th>Subject Id</th>
            <td>@Model.SubjectId</td>
        </tr>

    </table>

    <button name="Decison"value="Yes"class="btn btn-danger"> Yes</button>

    <button name="Decison"value="No"class="btn btn-secondary"> No </button>

</form>