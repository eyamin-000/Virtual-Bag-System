@{
}
@model BLL.DTOs.TeacherAssignmentDTO

<h1>Update Teacher Assignment</h1>

<form method="post">

    <input asp-for="AssignmentId" hidden />
    <input asp-for="AssignedAt" hidden />

    <div class="form-group">
        <label>Teacher</label>

        <select asp-for="TeacherId" class="form-control">

            @foreach (var t in ViewBag.Teachers)
            {
                <option value="@t.UserId">
                    @t.FullName
                </option>
            }

        </select>
    </div>

    <div class="form-group mt-2">
        <label>Class</label>

        <select asp-for="ClassId" class="form-control">

            @foreach (var c in ViewBag.Classes)
            {
                <option value="@c.ClassId">
                    @c.ClassName
                </option>
            }

        </select>
    </div>

    <div class="form-group mt-2">
        <label>Subject</label>

        <select asp-for="SubjectId" class="form-control">

            @foreach (var s in ViewBag.Subjects)
            {
                <option value="@s.SubjectId">
                    @s.SubjectName
                </option>
            }

        </select>
    </div>

    <div class="mt-3">
        <input type="submit" value="Update" class="btn btn-success" />
    </div>

</form>