@{
}
@model BLL.DTOs.UserDTO

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete User</h1>

<h4>Are you sure?</h4>

<form method="post">

    <input asp-for="UserId" hidden />

    <table class="table table-bordered">

        <tr>
            <th>Name</th>
            <td>@Model.FullName</td>
        </tr>

        <tr>
            <th>Email</th>
            <td>@Model.Email</td>
        </tr>

        <tr>
            <th>Role</th>
            <td>@Model.Role</td>
        </tr>

    </table>

    <button name="Decison" value="Yes" class="btn btn-danger"> Yes</button>

    <button name="Decison" value="No" class="btn btn-secondary"> No</button>

</form>
